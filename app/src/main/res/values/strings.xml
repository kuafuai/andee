    <string name="notification_relay_label">Andee 通知读取</string>

    <!--
        The settings sheet. Default language is Chinese: this file is `values/`
        so an unmatched locale falls back here, and the app has shipped Chinese
        from the start. `values-en/` mirrors it key for key — a key added here
        and not there silently shows Chinese on an English tablet.

        Not every Chinese literal in the app belongs in here. The policy — what
        the user reads versus what the model reads versus what matches system
        text — is written out at the top of `values-en/strings.xml`; read that
        before adding a string or "fixing" a deliberate omission.
    -->
