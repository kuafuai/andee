<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Body" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <!--
      三个全屏 Activity(HtmlActivity / LookActivity / ScanActivity)共用。
      继承 Theme.Body 会拿到 colorPrimaryVariant 当状态栏色,也就是一条紫杠;
      而 DayNight 的浅色 windowBackground 会让每次打开先白闪一下再变深。
      两条都和 app 其余部分(纯黑 + #7FA5FF,见 ui/Glass.kt)无关,所以这里
      全部按住。windowBackground 就是 Glass 的底色:overlay 卡片、弹框和这
      三张全屏脸是同一套配色,开屏那一帧不该是例外。
    -->
    <style name="Theme.Body.Fullscreen" parent="Theme.Body">
        <!-- DarkActionBar hands every one of these an "Andee" title bar over
             the brain's content, and on the camera screens it covered the ✕
             pill outright. HtmlActivity used to hide it in code; doing it here
             means a new full-screen face can't forget. -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#FF000000</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!--
      三个全屏脸(HtmlActivity / LookActivity / ScanActivity)现在共用的入场
      与退场,见 ui/Stage.kt。

      windowAnimationStyle="@null" 是这里唯一新增的一项,也是"关掉时闪一下"
      的真正原因:继承链上没人动过这一项,所以平台在 finish() 之后照常
      播放它自己的退出动画 —— 动画的内容已经不在屏幕上,淡出的只是一片
      空窗口;而底下 overlay 卡片是在 onDestroy 之后才开始恢复的。两段
      动作因此错开,中间那一帧谁也不是,那就是用户看到的闪。

      改成"淡入同时缩放"和"淡出同时缩小"由 StageActivity 自己画,平台的
      这一项只需要闭嘴。enter/exit 都留 0,是因为 enter 的动画在
      onCreate 之后才起,平台那一帧已经画完了 —— 留 0 是不给它任何机会。
    -->
    <style name="Theme.Body.Stage" parent="Theme.Body.Fullscreen">
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!--
      桌面图标(SelfCheckActivity)专用。服务在跑的时候,那颗图标的意思就是
      "打开 app":这一路上 Activity 一个像素都不画,expand() 完就 finish ——
      见 SelfCheckActivity.onCreate。但平台在 Activity 首次绘制之前会先按
      windowBackground 铺一张 starting window,于是体感变成"点图标 → 屏幕
      黑一下 → 卡片长出来",而长按球球没有这一下。关掉它,两条路的入场才是
      同一件事。

      无障碍关着时这一项也无害:那一路本来就是纯黑底 + revealStage 从 0.94
      长出来,起始帧是黑是空没有区别,而卡片第一帧由 SelfCheck.local 同步
      给出,不存在等网络的黑屏。
    -->
    <style name="Theme.Body.Stage.NoPreview" parent="Theme.Body.Stage">
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>