#!/usr/bin/env python3
# A stand-in for `dsh --profile sdk`: the same newline JSON-RPC, no model. A query writes out.md in the working
# folder and answers with one assistant message. A job whose text says [slow] hangs in session/wait until killed.
import json, os, sys, time

session = None
slow = False
cwd = os.getcwd()

def send(o):
    sys.stdout.write(json.dumps(o) + "\n")
    sys.stdout.flush()

def event(kind, data):
    send({"jsonrpc": "2.0", "method": "session.event", "params": {"sessionId": session, "event": {"type": kind, "data": data}}})

for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    m = json.loads(line)
    method, rid, p = m.get("method"), m.get("id"), m.get("params") or {}
    if method == "initialize":
        cwd = p.get("cwd", cwd)
        send({"jsonrpc": "2.0", "id": rid, "result": {"serverInfo": {"name": "fake"}}})
    elif method == "session/resume" and os.path.exists(os.path.join(cwd, ".held")):
        # Another dsh window has this session open for writing, as the user's own dsh web does.
        send({"jsonrpc": "2.0", "id": rid, "error": {"code": -32000,
              "message": 'session "%s" is already owned by an active write handle' % p["sessionId"]}})
    elif method in ("session/working-directory/set", "session/resume"):
        session = p["sessionId"]
        with open(os.path.join(cwd, ".fake-calls"), "a") as f:
            f.write(method + " " + session + "\n")
        send({"jsonrpc": "2.0", "id": rid, "result": {"cwd": cwd}})
    elif method == "session/query":
        with open(os.path.join(cwd, ".fake-brief"), "w") as f:
            f.write(json.dumps(p.get("contentBlocks"), ensure_ascii=False))
        send({"jsonrpc": "2.0", "id": rid, "result": {}})
        slow = "[slow]" in json.dumps(p.get("contentBlocks"))
        if slow:
            continue
        event("step/start", {"step": 1})
        event("todo/write", {"todos": [{"content": "find the numbers", "status": "completed"},
                                       {"content": "write it up", "status": "in_progress"}]})
        event("tool/call", {"name": "web_search", "arguments": json.dumps({"queries": ["week 46 numbers", "b"]})})
        event("tool/call", {"name": "write", "arguments": json.dumps({"file_path": cwd + "/out.md"})})
        with open(os.path.join(cwd, "out.md"), "a") as f:
            f.write("Week 46\n")
        event("step/end", {})
        event("assistant/message", {"message": {"content": [{"type": "text", "text": "Wrote out.md with the week."}]},
                                    "usage": {"inputTokens": 100, "outputTokens": 20}})
        event("turn/end", {"reason": {"kind": "completed"}})
    elif method == "session/wait":
        if slow:
            time.sleep(600)
        send({"jsonrpc": "2.0", "id": rid, "result": {}})
    elif method == "shutdown":
        send({"jsonrpc": "2.0", "id": rid, "result": {}})
        sys.exit(0)
    elif rid is not None:
        send({"jsonrpc": "2.0", "id": rid, "error": {"code": -32601, "message": "no"}})
